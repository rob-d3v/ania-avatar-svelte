{
  "name": "ania-avatar-svelte",
  "version": "1.0.0",
  "description": "Svelte 5 wrapper for the Ania animated-avatar player. Mounts an avatar onto a <canvas> and drives lip-sync, actions, commands, TTS/STT/wake-word via the framework-agnostic ania-avatar-core engine. Runes-based, fully typed.",
  "type": "module",
  "license": "MIT",
  "author": "rob-d3v",
  "repository": "github:rob-d3v/ania-avatar-svelte",
  "homepage": "https://github.com/rob-d3v/ania-avatar-svelte#readme",
  "bugs": "https://github.com/rob-d3v/ania-avatar-svelte/issues",
  "keywords": [
    "ania",
    "avatar",
    "svelte",
    "svelte5",
    "runes",
    "vtuber",
    "lip-sync",
    "tts",
    "stt",
    "wake-word",
    "canvas",
    "web-component",
    "custom-element",
    "typescript"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./element": {
      "default": "./dist/ania-avatar-element.js"
    },
    "./package.json": "./package.json"
  },
  "unpkg": "./dist/ania-avatar-element.js",
  "jsdelivr": "./dist/ania-avatar-element.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "svelte-package && npm run build:element && node -e \"require('fs').rmSync('dist/__package_types_tmp__',{recursive:true,force:true})\"",
    "build:package": "svelte-package",
    "build:element": "vite build -c vite.element.config.ts",
    "prepublishOnly": "npm run build",
    "check": "svelte-check --tsconfig ./tsconfig.json"
  },
  "peerDependencies": {
    "svelte": ">=5"
  },
  "dependencies": {
    "ania-avatar-core": "github:rob-d3v/ania-avatar-core"
  },
  "devDependencies": {
    "@sveltejs/package": "^2.3.7",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "publint": "^0.3.2",
    "svelte": "^5.19.0",
    "svelte-check": "^4.1.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}
